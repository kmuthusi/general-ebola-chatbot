# Copy to .env and adjust for the deployment host.
# Set an absolute path to the reviewed WHO PDF directory when deploying elsewhere.
GUIDELINE_SOURCE_DIR=./who_guidelines
APP_PORT=8501
OLLAMA_CHAT_MODEL=llama3.1:8b
# Optional separate model for checking each claim against its cited passage.
# Defaults to OLLAMA_CHAT_MODEL if omitted.
# OLLAMA_VERIFY_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_KEEP_ALIVE=30m
EVIDENCE_PASSAGES=5
MAX_CONCURRENT_ANSWERS=2
# Required only when using compose.public.yaml. Point DNS to the deployment host.
# SITE_DOMAIN=chat.example.org
